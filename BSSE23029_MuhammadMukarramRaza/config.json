      "risk_score": true,
      "llm_narrative": true,
      "vision_summary": true,
      "include_raw_turns": false
    },
    "llm_narrative_prompt": "You are writing a {audience} report.\nRisk score: {risk_score}/100  →  Recommended action: {action}\nSession summary: {tier_summary}\n\nFull conversation:\n{conversation}\n\nWrite a concise clinical narrative (3-5 sentences) covering:\n- the student's emotional arc across the session\n- the main support needs identified\n- any critical moments (crisis alerts, escalations)\n- a clear recommended next step for the support team.\nDo NOT repeat the raw numbers — interpret them in plain language.\n",
    "narrative_audience": "university counselling team",
    "banner_title": "SESSION INTELLIGENCE REPORT",
    "banner_subtitle": "Counsellor Eyes Only",
    "banner_width": 55
