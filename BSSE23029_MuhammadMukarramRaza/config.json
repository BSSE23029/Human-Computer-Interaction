{
  "llm": {
    "base_url": "http://localhost:11434/v1",
    "api_key": "ollama",
    "model": "llama3",
    "temperature": 0.4,
    "max_tokens": 512,
    "timeout_seconds": 60,
    "system_prompt": "You are a concise, empathetic assistant. Reply in 1-3 sentences.",
    "active_persona": "default",
    "personas": {
      "default": "a concise, empathetic university wellbeing assistant. Reply in 1-3 supportive sentences.",
      "tutor": "a patient academic tutor who explains clearly and encourages the student.",
      "support": "a calm, professional customer-service agent. Be polite and solution-focused."
    },
    "use_json_format": false,
    "prompts": {
      "classify": "Classify the message into exactly ONE of these labels: {labels}. Reply with ONLY the label, nothing else.\nMessage: {text}\nLabel:",
      "multilabel": "From these labels: {labels}, list ALL that apply to the message as a comma-separated list. Reply with ONLY labels.\nMessage: {text}\nLabels:",
      "score": "Rate the {criterion} of this message on a scale from {lo} to {hi}. Reply with ONLY a number.\nMessage: {text}\nNumber:",
      "extract": "Extract these fields from the message and reply with ONLY a JSON object using exactly these keys: {fields}.\nMessage: {text}\nJSON:",
      "summarize": "Summarize the conversation below in about {max_words} words for {audience}.\nConversation:\n{conversation}\nSummary:"
    }
  },
  "whisper": {
    "model_size": "base",
    "language": null,
    "fp16": false
  },
  "audio": {
    "sample_rate": 16000,
    "seconds": 7,
    "channels": 1
  },
  "voice": {
    "recognizer": "whisper",
    "countdown": true,
    "silence_threshold": 0.01,
    "silence_max_seconds": 2.0,
    "confidence_min_chars": 10
  },
  "sentiment": {
    "positive_words": {
      "happy": 2.0,
      "good": 1.5,
      "great": 2.0,
      "better": 1.5,
      "calm": 1.5,
      "hopeful": 1.8,
      "relieved": 1.6,
      "thanks": 1.2,
      "love": 2.0,
      "excited": 1.8,
      "confident": 1.6
    },
    "negative_words": {
      "sad": 2.0,
      "stressed": 2.0,
      "anxious": 2.2,
      "hopeless": 3.0,
      "depressed": 3.0,
      "overwhelmed": 2.5,
      "alone": 2.0,
      "lonely": 2.0,
      "afraid": 2.2,
      "tired": 1.5,
      "fail": 1.8,
      "failed": 1.8,
      "panic": 2.4,
      "cry": 2.0,
      "worried": 1.8
    },
    "boosters": {
      "very": 1.5,
      "really": 1.4,
      "completely": 1.7,
      "so": 1.3,
      "extremely": 1.8
    },
    "negations": [
      "not",
      "no",
      "never",
      "cannot",
      "can't",
      "don't",
      "didn't"
    ]
  },
  "scale": {
    "at_risk_tiers": [
      "CRISIS"
    ],
    "tiers": [
      [
        "THRIVING",
        0.6,
        100.0,
        "🌟"
      ],
      [
        "CONTENT",
        0.2,
        0.6,
        "😊"
      ],
      [
        "NEUTRAL",
        -0.19,
        0.2,
        "😐"
      ],
      [
        "STRESSED",
        -0.4,
        -0.19,
        "😟"
      ],
      [
        "DISTRESSED",
        -0.6,
        -0.4,
        "😢"
      ],
      [
        "CRISIS",
        -100.0,
        -0.6,
        "🆘"
      ]
    ]
  },
  "categories": {
    "ACADEMIC": [
      "assignment",
      "deadline",
      "exam",
      "grade",
      "fail",
      "pass",
      "lecture",
      "study",
      "professor",
      "submit",
      "midterm",
      "course"
    ],
    "WELLBEING": [
      "stress",
      "anxious",
      "depressed",
      "lonely",
      "overwhelmed",
      "panic",
      "cry",
      "hopeless",
      "afraid",
      "sleep",
      "sad"
    ],
    "FINANCIAL": [
      "fees",
      "scholarship",
      "loan",
      "afford",
      "money",
      "rent",
      "bursary",
      "payment",
      "debt",
      "overdue"
    ],
    "TECHNICAL": [
      "portal",
      "login",
      "password",
      "system",
      "error",
      "access",
      "email",
      "vpn",
      "reset",
      "laptop",
      "broke",
      "files"
    ],
    "SOCIAL": [
      "friends",
      "roommate",
      "belong",
      "isolated",
      "group",
      "relationship",
      "community",
      "alone"
    ],
    "ADMIN": [
      "enrolment",
      "certificate",
      "transcript",
      "registration",
      "form",
      "office",
      "register"
    ]
  },
  "intents": {
    "greeting": [
      "hi",
      "hello",
      "hey",
      "good morning",
      "good afternoon"
    ],
    "goodbye": [
      "bye",
      "goodbye",
      "see you",
      "thank you",
      "thanks"
    ],
    "question": [
      "?",
      "how",
      "what",
      "why",
      "when",
      "where",
      "who"
    ],
    "complaint": [
      "angry",
      "terrible",
      "worst",
      "unacceptable",
      "broken",
      "awful"
    ],
    "request": [
      "please",
      "can you",
      "could you",
      "i need",
      "i want",
      "help"
    ]
  },
  "transitions": {
    "escalation_into": [
      "WELLBEING"
    ]
  },
  "responses": {
    "use_llm_fallback": true,
    "default": "Thank you for sharing that. Can you tell me a little more?",
    "rules": {
      "WELLBEING|CRISIS": "I am very concerned about you. Please contact the university counselling line RIGHT NOW: 0800-XXX-XXXX.",
      "WELLBEING|DISTRESSED": "It sounds like you are going through a really difficult time. Have you spoken to anyone about how you are feeling?",
      "ACADEMIC|STRESSED": "Exam pressure is real. Let us look at what support your faculty offers -- have you spoken to your tutor?",
      "FINANCIAL|*": "Financial difficulty is more common than you think. The university bursary office can help -- shall I give you their contact?",
      "TECHNICAL|*": "Let me help you with that technical issue. Which system are you trying to access?",
      "SOCIAL|DISTRESSED": "Feeling isolated at university is incredibly hard. The student union runs weekly social events -- would that help?"
    }
  },
  "scoring": {
    "base_risk": 20,
    "wellbeing_weight": 40,
    "at_risk_weight": 15,
    "escalation_weight": 10,
    "verbose_words_per_turn": 20,
    "verbose_bonus": 5,
    "thresholds": {
      "URGENT_REFERRAL": 70,
      "FOLLOW_UP": 40,
      "NO_ACTION": 0
    }
  },
  "vision": {
    "webcam_index": 0,
    "flip_webcam": true,
    "wait_key_ms": 1,
    "haar": {
      "face": "haarcascade_frontalface_default.xml",
      "eye": "haarcascade_eye.xml",
      "smile": "haarcascade_smile.xml",
      "face_scale": 1.1,
      "face_neighbors": 5,
      "eye_neighbors": 8,
      "smile_neighbors": 20
    },
    "blink": {
      "eyes_closed_frames": 2
    },
    "drowsy": {
      "closed_frames_alert": 20
    },
    "head_zones": {
      "deadzone_ratio": 0.15
    },
    "skin_ycrcb": {
      "lower": [
        0,
        133,
        77
      ],
      "upper": [
        255,
        173,
        127
      ]
    },
    "gesture_map": {
      "0": [
        "Fist",
        "✊"
      ],
      "1": [
        "One",
        "☝️"
      ],
      "2": [
        "Peace",
        "✌️"
      ],
      "3": [
        "Three",
        "3️⃣"
      ],
      "4": [
        "Four",
        "4️⃣"
      ],
      "5": [
        "Open Hand",
        "🖐"
      ]
    },
    "color_presets": {
      "red": {
        "lower": [
          0,
          120,
          70
        ],
        "upper": [
          10,
          255,
          255
        ]
      },
      "green": {
        "lower": [
          40,
          70,
          70
        ],
        "upper": [
          80,
          255,
          255
        ]
      },
      "blue": {
        "lower": [
          100,
          150,
          0
        ],
        "upper": [
          140,
          255,
          255
        ]
      }
    },
    "motion": {
      "method": "diff",
      "threshold": 25,
      "min_area": 500
    }
  },
  "ui": {
    "app_title": "Multimodal HCI Assistant",
    "app_subtitle": "Text + Voice + Vision  |  llama3 (Ollama) + Whisper + OpenCV",
    "controls_hint": "[SPACE] Pause/Play   [R] Replay   [ESC] Exit",
    "report_banner": "SESSION INTELLIGENCE REPORT",
    "report_code": "Counsellor Eyes Only",
    "exit_key": 27,
    "server_port": 7860
  }
}