      }
    },
    {
      "name": "context_inject",
      "type": "context_injector",
      "enabled": true,
      "method": "context",
      "fallback": {
        "true": "failure",
        "value": {
          "injected": false
        }
      },
      "config": {
        "score_weights": {
          "happy": 0.3,
          "neutral": 0.0,
          "surprised": 0.1,
